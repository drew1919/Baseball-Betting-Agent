# Optional: server port (default: 3000)
PORT=3000

# Optional: The-Odds-API key for live betting odds
# Get yours at https://the-odds-api.com
ODDS_API_KEY=

# Optional: preferred bookmaker for odds (default: fanduel)
# Options: fanduel, draftkings, betmgm, caesars, etc.
ODDS_BOOKMAKER=fanduel

# Canonical immutable pregame snapshot time (default: 09:05 America/New_York)
MORNING_REFRESH_TIME_ZONE=America/New_York
MORNING_REFRESH_HOUR=9

# Optional: custom paths to Statcast CSV exports from Baseball Savant
# Leave blank to use the built-in dataset
EXPECTED_BATTERS_CSV_PATH=
EXPECTED_PITCHERS_CSV_PATH=
